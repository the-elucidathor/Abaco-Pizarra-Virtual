{
  "appId": "org.abaco.pizarravirtual",
  "productName": "Ábaco Pizarra Virtual",
  "directories": {
    "output": "release-windows",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "the-elucidathor",
      "repo": "Abaco-Pizarra-Virtual",
      "releaseType": "release"
    }
  ],
  "win": {
    "target": ["nsis"],
    "icon": "build/icon.ico",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "fileAssociations": [
    {
      "ext": "pizarra",
      "name": "Archivo de Ábaco Pizarra Virtual",
      "description": "Documento de Ábaco Pizarra Virtual",
      "icon": "build/pizarra.ico"
    }
  ],
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Ábaco Pizarra Virtual",
    "license": "build/license.txt"
  }
}

